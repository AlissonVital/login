# Neon PostgreSQL (nunca exponha no front-end)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/modelo_login?sslmode=require

# JWT - gere uma chave forte (ex: openssl rand -base64 48)
JWT_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria

# Validade da sessão em horas
JWT_EXPIRES_HOURS=24

# URL pública do site (usada no link de recuperação de senha)
APP_URL=http://localhost:3000

# E-mail (SMTP) — necessário para envio real de recuperação
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu@email.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM="Site Modelo <noreply@seudominio.com>"

# Em true, a API devolve o link de recuperação na resposta (só para testes)
DEV_RETURN_RECOVERY_LINK=true
