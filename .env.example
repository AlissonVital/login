# Neon PostgreSQL (nunca exponha no front-end)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/modelo_login?sslmode=require

# JWT - gere uma chave forte (ex: openssl rand -base64 48)
JWT_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria

# Validade da sessão em horas
JWT_EXPIRES_HOURS=24

# URL pública do site (usada no link de recuperação de senha)
APP_URL=https://login-seven-flame.vercel.app

# E-mail (SMTP Gmail) — necessário para envio real de recuperação
# 1) Ative a verificação em 2 etapas na conta Google
# 2) Crie uma "Senha de app" em https://myaccount.google.com/apppasswords
# 3) Use essa senha de 16 caracteres em SMTP_PASS (não use a senha normal do Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alissonferreiravital@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="Site Modelo <alissonferreiravital@gmail.com>"

# Em true, a API devolve o link de recuperação na resposta (só para testes locais)
# Em produção na Vercel, deixe false
DEV_RETURN_RECOVERY_LINK=false
